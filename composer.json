{
  "name": "denosyscore/encryption",
  "description": "Encryption services",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Encryption\\": "src/Encryption/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.22.x-dev"
    }
  }
}
